# Secrets: never commit the real key. Copy .env.example to .env instead.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc

# Node / Vite
node_modules/
frontend/dist/

# Local logs and scratch files
*.log
*.json.tmp

# Editor / OS / local tool config
.DS_Store
.claude/

# NOTE: data/*.db is intentionally NOT ignored. Both databases are part of the repo.

# Generated at runtime, kept out of the submission so the repo matches the required layout:
# the board is rebuilt by the MCP server, and the per-tool smoke files are combined in output/mcp_smoke.json.
output/board.json
output/board.md
output/db_viewer.html
output/mcp_smoke/
